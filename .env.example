# It's God, Yo — environment template. Copy to .env.local and fill in.
# Price IDs are safe to expose (public); secret keys are NOT — never commit real values.

# --- Supabase (project ref bkwtlfkhfbfyzgnozixw) ---
NEXT_PUBLIC_SUPABASE_URL=https://bkwtlfkhfbfyzgnozixw.supabase.co
# The web app calls the submit-consent Edge Function, which has verify_jwt=true.
# That gateway requires a JWT, so this MUST be the legacy ANON key (a JWT), NOT a
# sb_publishable_ key. Anon keys are public-by-design and safe to ship client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiI...   # anon JWT (public)
SUPABASE_SERVICE_ROLE_KEY=            # server-only; used by Edge Functions, never client-side

# --- Stripe (TEST mode; dedicated IGY sandbox account acct_1TvPGDGYyfOIjQvM) ---
STRIPE_SECRET_KEY=rk_test_xxx                 # server-only (restricted key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Price IDs (test mode, new dedicated account) — see config/stripe-prices.json for the source of truth
NEXT_PUBLIC_PRICE_INDIVIDUAL_MONTHLY=price_1TvePoGYyfOIjQvMi7r2wXD3
NEXT_PUBLIC_PRICE_INDIVIDUAL_ANNUAL=price_1TvePpGYyfOIjQvMDxEJsqNe
NEXT_PUBLIC_PRICE_FAMILY_ANNUAL=price_1TvePpGYyfOIjQvMDbu9cFli
NEXT_PUBLIC_PRICE_GIFT_ANNUAL=price_1TvePqGYyfOIjQvMErLxfVjd
NEXT_PUBLIC_PRICE_GROUP_1_50=price_1TvePqGYyfOIjQvM4sSSy0mi
NEXT_PUBLIC_PRICE_GROUP_51_150=price_1TvePqGYyfOIjQvMNuPHE8SF
NEXT_PUBLIC_PRICE_GROUP_151_300=price_1TvePrGYyfOIjQvMJUcLgxJW
NEXT_PUBLIC_PRICE_DM_ADDON_MONTHLY=price_1TvePrGYyfOIjQvM1w2NJZ2u
# Group 301+ is manual/negotiated — no self-serve Price (contact-us path)

# --- Stripe webhook + deferred subscription creation ---
# From `stripe listen` (local) or the Dashboard webhook endpoint's signing secret (prod).
STRIPE_WEBHOOK_SECRET=whsec_xxx                 # server-only; verifies /api/stripe/webhook
# Shared secret protecting /api/internal/confirm-signup (the deferred subscription trigger).
# Stands in for the future Twilio "YES" handler; must NOT be publicly guessable.
INTERNAL_CONFIRM_SECRET=

# --- Twilio (account still in verification — code is wired but inert until set) ---
# Outbound (submit-consent Edge Function): sends the confirmation SMS. No creds =>
# stub behavior preserved (bodies logged, not sent). Set as Supabase function secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Inbound "YES" handler (/api/twilio/inbound, a Vercel route): TWILIO_AUTH_TOKEN
# above gates + signs it (no token => 503). Point Twilio's inbound webhook at
# https://its-god-yo.vercel.app/api/twilio/inbound and set that exact URL here so
# signature verification matches. Set TWILIO_AUTH_TOKEN as a Vercel env too.
TWILIO_INBOUND_URL=https://its-god-yo.vercel.app/api/twilio/inbound

# --- Church Outreach Agent (spec: IGY-Church-Outreach-Agent-Spec-v1-READY-CORRECTED.md) ---
# Discovery: Claude API + web search. No key => discovery no-ops (logs, sends nothing).
ANTHROPIC_API_KEY=
OUTREACH_DISCOVERY_MODEL=claude-sonnet-5
OUTREACH_GEOGRAPHY=the Wichita, Kansas metro area   # Phase 1; widen only after a clean cycle (§6)
OUTREACH_DISCOVERY_TARGET_COUNT=15
# Sending identity (Iain 2026-07-27): SendGrid was a spec error — we use Resend
# (RESEND_API_KEY is the same one lib/sponsorInquiry.ts already uses). Send FROM the
# dedicated outreach subdomain; replies go to Iain's Gmail.
OUTREACH_FROM=It's God, Yo <hello@outreach.itsgodyo.com>
OUTREACH_REPLY_TO=iaindeckard@gmail.com
OUTREACH_APP_URL=https://itsgodyo.com                # where the one-click unsubscribe route is served
# Signs the one-click unsubscribe token (falls back to CRON_SECRET if unset).
OUTREACH_UNSUB_SECRET=
# Resend event webhook (hard-bounce / complaint suppression). Svix secret from the
# Resend dashboard webhook. No secret => the webhook route returns 503.
RESEND_WEBHOOK_SECRET=

# --- THE SEND GATE (all THREE must be "true" for a LIVE send; default = dry-run) ---
# Per Iain: nothing reaches a real org until he signs off on the email COPY and the
# LEGAL review, separately from the build. Leave unset until both are approved.
OUTREACH_COPY_APPROVED=       # "true" once Iain approves the drafted email copy
OUTREACH_LEGAL_APPROVED=      # "true" once the legal review clears
OUTREACH_SEND_LIVE=           # "true" master switch to actually send
# Optional: restrict the FIRST live batch to specific addresses (comma-separated).
OUTREACH_SEND_ALLOWLIST=
